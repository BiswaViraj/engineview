# Copy to .env for local development. Never commit .env.

# Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/engineview

# Secret used by better-auth to sign sessions. Use a long random string,
# e.g. `openssl rand -hex 32`.
BETTER_AUTH_SECRET=replace_me_with_a_long_random_string

# Public base URL of the app.
BETTER_AUTH_URL=http://localhost:3000

# 32-byte key (hex) used to encrypt stored Cloudflare API tokens at rest.
# Generate with `openssl rand -hex 32`. Changing it makes existing tokens
# unreadable, so set it once and keep it safe.
ENCRYPTION_KEY=replace_me_with_a_64_char_hex_string
